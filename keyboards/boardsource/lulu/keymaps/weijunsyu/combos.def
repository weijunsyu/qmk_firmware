// Combo list (name, result, chord keys)
// Navigation (left hand)
COMB(_CB_LUP,     KC_UP,           KC_E, KC_D)
COMB(_CB_LDN,     KC_DOWN,         KC_R, KC_F)
COMB(_CB_LLT,     KC_LEFT,         KC_W, KC_S)
COMB(_CB_LRT,     KC_RIGHT,        KC_T, KC_G)
COMB(_CB_LPUP,    KC_PGUP,         KC_D, KC_C)
COMB(_CB_LPDN,    KC_PGDN,         KC_F, KC_V)
COMB(_CB_LHOME,   KC_HOME,         KC_S, KC_X)
COMB(_CB_LEND,    KC_END,          KC_G, KC_B)
// Navigation (right hand)
COMB(_CB_RUP,     KC_UP,           KC_I, KC_K)
COMB(_CB_RDN,     KC_DOWN,         KC_U, KC_J)
COMB(_CB_RLT,     KC_LEFT,         KC_Y, KC_H)
COMB(_CB_RRT,     KC_RIGHT,        KC_O, KC_L)
COMB(_CB_RPUP,    KC_PGUP,         KC_K, KC_COMM)
COMB(_CB_RPDN,    KC_PGDN,         KC_J, KC_M)
COMB(_CB_RHOME,   KC_HOME,         KC_H, KC_N)
COMB(_CB_REND,    KC_END,          KC_L, KC_DOT)
// Navigation (right hand numbers)
COMB(_CB_NUP,     KC_UP,           KC_8, KC_5)
COMB(_CB_NDN,     KC_DOWN,         KC_7, KC_4)
COMB(_CB_NLT,     KC_LEFT,         KC_MINS, KC_PLUS)
COMB(_CB_NRT,     KC_RIGHT,        KC_9, KC_6)
COMB(_CB_NPUP,    KC_PGUP,         KC_5, KC_2)
COMB(_CB_NPDN,    KC_PGDN,         KC_4, KC_1)
COMB(_CB_NHOME,   KC_HOME,         KC_PLUS, KC_EQUAL)
COMB(_CB_NEND,    KC_END,          KC_6, KC_3)
// Media
COMB(_CB_MUT,     KC_MUTE,         KC_VOLD, KC_VOLU)
// Shortcut combos
COMB(_CB_DFT,     _CTLDFT,         _CTLPLS, _CTLMIN)
// Firmware combos
COMB(_CB_BOT,     _KC_BOT,         _KC_FHL, _KC_FHR)
